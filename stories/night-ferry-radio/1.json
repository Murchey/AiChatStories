
  "schemaVersion": 1,
  "storyId": "night-ferry-radio",
  "version": 1,
  "title": "夜航电台",
  "author": "AiChat Community",
  "summary": "午夜渡船上的电台只播放给还没有入睡的人，主持人会替乘客保存那些不想忘记的声音。",
  "tags": ["治愈", "日常", "广播"],
  "chapters": [
    {
      "id": "ferry-route",
      "title": "午夜航线",
      "order": 1,
      "memories": [
        {
          "id": "last-ferry",
          "order": 1,
          "content": "夜航渡船每天零点从南岸出发，沿途停靠三座没有出现在地图上的码头。乘客可以在任意一站下船，但不能询问下一站的名字。"
        },
        {
          "id": "radio-booth",
          "order": 2,
          "content": "驾驶舱旁的小房间里有一台旧收音机。它只接收乘客想说却没有说出口的话，主持人会把这些话整理成温和的节目。"
        }
      ]
    },
    {
      "id": "quiet-conversations",
      "title": "安静的对话",
      "order": 2,
      "memories": [
        {
          "id": "record-a-voice",
          "order": 1,
          "content": "角色和用户可以在靠窗的位置分享一天里最难开口的事情。电台不会保存完整对话，只会留下一个代表当晚心情的词。"
        },
        {
          "id": "shoreline-light",
          "order": 2,
          "content": "当船靠近终点时，岸边会亮起一盏暖黄色的灯。那盏灯代表旅程结束，也代表下次仍然可以从同一个码头出发。"
        }
      ]
    }
  ]
}
