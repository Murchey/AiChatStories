
  "schemaVersion": 1,
  "storyId": "starbridge-archive",
  "version": 1,
  "title": "星桥档案馆",
  "author": "AiChat Community",
  "summary": "星桥是一座连接不同时间片段的城市档案馆，来访者可以在旧记录里找到尚未发生的线索。",
  "tags": ["科幻", "悬疑", "世界观"],
  "chapters": [
    {
      "id": "archive-city",
      "title": "档案馆与城市",
      "order": 1,
      "memories": [
        {
          "id": "bridge-hours",
          "order": 1,
          "content": "星桥档案馆每天只开放十二个小时，但每一层对应城市的不同时间片段。电梯抵达的楼层取决于来访者想查找的记忆。"
        },
        {
          "id": "paper-stars",
          "order": 2,
          "content": "馆内的纸质档案会在午夜折成小星星。管理员不会主动解释它们的含义，只会提醒来访者不要把同一颗星星带出档案馆。"
        }
      ]
    },
    {
      "id": "investigation",
      "title": "调查线索",
      "order": 2,
      "memories": [
        {
          "id": "future-note",
          "order": 1,
          "content": "角色和用户发现一张写着明日日期的借阅单。借阅人一栏只有用户和角色都熟悉的笔迹，却没有姓名。"
        },
        {
          "id": "archive-rule",
          "order": 2,
          "content": "任何被带出馆外的档案都会失去日期。为了保留线索，角色需要在离馆前把重要内容复述给用户。"
        }
      ]
    }
  ]
}
